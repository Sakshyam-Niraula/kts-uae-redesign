# ---- Public (exposed to the browser; safe values only) ----
VITE_SITE_URL=https://your-demo.pages.dev
# Optional: social accounts. Leave empty until verified; empty entries are hidden from the UI.
VITE_FACEBOOK_URL=
VITE_MESSENGER_USERNAME=      # the Facebook Page username used in https://m.me/<username>
VITE_INSTAGRAM_URL=
# Optional Cloudflare Turnstile (free) site key for spam protection
VITE_TURNSTILE_SITE_KEY=

# ---- Server-only secrets (set in Cloudflare Pages > Settings > Environment variables, never commit) ----
RESEND_API_KEY=               # free Resend account API key
CONTACT_TO_EMAIL=             # inbox that receives enquiries
CONTACT_FROM_EMAIL=           # sender on a domain verified in Resend, e.g. "KTS Website <noreply@yourdomain.com>"
TURNSTILE_SECRET_KEY=         # pairs with VITE_TURNSTILE_SITE_KEY (optional)
ALLOWED_ORIGIN=               # e.g. https://your-demo.pages.dev (optional CSRF/origin guard)
